#!/usr/bin/env bash
set -Eeuo pipefail

ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"

usage() {
  cat <<'USAGE'
Usage: ./workshop <command> [options]

Commands:
  setup [--lean-only] [--skip-models]  Prepare the pinned workshop environment.
  doctor [--lean-only]                 Check prerequisites and explain fixes.
  check [--lean-only]                  Run local repository verification.
  scenario <command> [name]            Load, check, or reveal workshop scenarios.
  reset                                Restore committed playground files.
  agent                                Start the Google ADK command-line tutor.
  agent-web                            Start the Google ADK web tutor.
  aristotle [prompt]                   Submit this Lean project to Aristotle.
  help                                 Show this message.

Recommended first run:
  ./workshop setup
  ./workshop check

Start the first scenario:
  ./workshop scenario start lifecycle
  ./workshop scenario check
USAGE
}

command_name="${1:-help}"
if [[ $# -gt 0 ]]; then
  shift
fi

case "$command_name" in
  setup)
    exec bash "$ROOT/scripts/setup.sh" "$@"
    ;;
  doctor)
    exec bash "$ROOT/scripts/workshop_doctor.sh" "$@"
    ;;
  check)
    exec bash "$ROOT/scripts/verify.sh" "$@"
    ;;
  scenario)
    exec bash "$ROOT/scripts/scenario.sh" "$@"
    ;;
  reset)
    exec bash "$ROOT/scripts/reset_playground.sh" "$@"
    ;;
  agent)
    exec bash "$ROOT/scripts/run_agent.sh" "$@"
    ;;
  agent-web)
    exec bash "$ROOT/scripts/run_agent_web.sh" "$@"
    ;;
  aristotle)
    exec bash "$ROOT/scripts/aristotle_submit.sh" "$@"
    ;;
  help|-h|--help)
    usage
    ;;
  *)
    printf 'error: unknown command: %s\n\n' "$command_name" >&2
    usage >&2
    exit 2
    ;;
esac
