# Google ADK / Gemini. Copy this file to .env; never commit the real key.
GOOGLE_API_KEY=

# Set this only after the exact event model has been tested end to end.
# Do not rely on a stale hard-coded default in workshop material.
GOOGLE_MODEL=

# Optional safety tuning for the local Lean checker.
LEAN_CHECK_TIMEOUT_SECONDS=60
LEAN_CHECK_OUTPUT_LIMIT=12000
