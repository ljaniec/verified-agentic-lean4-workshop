#!/usr/bin/env bash
set -Eeuo pipefail
ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
usage() {
  cat <<'USAGE'
Usage: ./workshop <command> [options]

  browser list                 List the six current browser tasks.
  browser show 01              Print a complete starter for Lean Web.
  browser show 01 --completed  Print the scheduled slide checkpoint.
  browser check [FILE.lean]    Check the bundle or a copied local candidate.
  check [--lean-only]          Run local repository acceptance checks.
  task check                  Compatibility alias for the slide's local gate.
  help                        Show this message.

Event: open https://live.lean-lang.org/ and follow course/browser/README.md.
Print presentation/speaker_notes.pdf. No installation during the workshop.
USAGE
}
command_name="${1:-help}"
if [[ $# -gt 0 ]]; then shift; fi
case "$command_name" in
  browser) exec python3 "$ROOT/scripts/browser_workshop.py" "$@" ;;
  check) exec bash "$ROOT/scripts/verify.sh" "$@" ;;
  task)
    if [[ "$#" -eq 1 && "$1" == check ]]; then
      exec python3 "$ROOT/scripts/browser_workshop.py" check
    fi
    printf 'Use ./workshop browser; only task check remains as a slide-compatible alias.\n' >&2
    exit 2
    ;;
  help|-h|--help) usage ;;
  *) printf 'Unknown command: %s\n' "$command_name" >&2; usage >&2; exit 2 ;;
esac
