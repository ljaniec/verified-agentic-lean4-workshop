from __future__ import annotations

from dataclasses import dataclass
from enum import Enum, auto


@dataclass(frozen=True)
class Interval:
    lo: int
    hi: int

    def contains(self, point: int) -> bool:
        return self.lo <= point <= self.hi


class PlannerDecision(Enum):
    ACCEPT = auto()
    FALLBACK = auto()


def separated(path: Interval, obstacle: Interval) -> bool:
    return path.hi < obstacle.lo or obstacle.hi < path.lo


def decide_plan(path: Interval, obstacle: Interval) -> PlannerDecision:
    if separated(path, obstacle):
        return PlannerDecision.ACCEPT
    return PlannerDecision.FALLBACK


def decide_from_point_estimate(path: Interval, estimate: int) -> PlannerDecision:
    if path.contains(estimate):
        return PlannerDecision.FALLBACK
    return PlannerDecision.ACCEPT


def main() -> None:
    path = Interval(0, 8)
    obstacle_uncertainty = Interval(6, 10)
    point_estimate = 10

    point = decide_from_point_estimate(path, point_estimate)
    robust = decide_plan(path, obstacle_uncertainty)

    print(f"point estimate decision: {point.name}")
    print(f"uncertainty-set decision: {robust.name}")

    assert point is PlannerDecision.ACCEPT
    assert robust is PlannerDecision.FALLBACK
    print("uncertainty checkpoint passed")


if __name__ == "__main__":
    main()
