from __future__ import annotations

from dataclasses import dataclass
from enum import Enum, auto
from itertools import product
from typing import Iterable


class Mode(Enum):
    UNCONFIGURED = auto()
    INACTIVE = auto()
    ACTIVE = auto()
    FINALIZED = auto()


class Event(Enum):
    CONFIGURE = auto()
    ACTIVATE = auto()
    DEACTIVATE = auto()
    CLEANUP = auto()
    SHUTDOWN = auto()
    RECOVER_FROM_ERROR = auto()


@dataclass(frozen=True)
class State:
    mode: Mode
    sensor_open: bool
    log_open: bool
    actuator_enabled: bool


INITIAL = State(Mode.UNCONFIGURED, False, False, False)
ACTIVE_STATE = State(Mode.ACTIVE, True, True, True)


def safe(state: State) -> bool:
    active_has_resources = state.mode is not Mode.ACTIVE or (
        state.sensor_open and state.log_open
    )
    sensor_guard = not state.sensor_open or state.mode is Mode.ACTIVE
    log_guard = not state.log_open or state.mode is Mode.ACTIVE
    actuator_guard = not state.actuator_enabled or state.mode is Mode.ACTIVE
    terminal_cleanup = state.mode not in {Mode.UNCONFIGURED, Mode.FINALIZED} or (
        not state.sensor_open
        and not state.log_open
        and not state.actuator_enabled
    )
    return (
        active_has_resources
        and sensor_guard
        and log_guard
        and actuator_guard
        and terminal_cleanup
    )


def buggy_step(state: State, event: Event) -> State:
    if state.mode is Mode.ACTIVE and event is Event.DEACTIVATE:
        return State(
            Mode.INACTIVE,
            state.sensor_open,
            state.log_open,
            state.actuator_enabled,
        )
    return state


def step(state: State, event: Event) -> State:
    """TODO: implement the corrected transition function."""
    raise NotImplementedError


def run(state: State, events: Iterable[Event]) -> State:
    for event in events:
        state = step(state, event)
    return state


